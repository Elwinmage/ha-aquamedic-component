  "services": {
    "set_schedule": {
      "name": "Zeitplan festlegen",
      "description": "Ersetzt das gesamte Zeitfenster-Programm einer Pumpe. Die Pumpe folgt ihm nur, solange ihr Timer-Schalter eingeschaltet ist.",
      "fields": {
        "entity_id": {
          "name": "Zeitplan-Sensor",
          "description": "Zeitplan-Sensor der zu programmierenden Pumpe(n)."
        },
        "device_id": {
          "name": "Gerät",
          "description": "Zu programmierende Pumpe(n), alternativ zum Zeitplan-Sensor."
        },
        "slots": {
          "name": "Zeitfenster",
          "description": "Liste der Zeitfenster (höchstens 48), jeweils mit start und end (HH:MM oder Minuten seit Mitternacht), mode und value. Eine leere Liste löscht das Programm. Zeitfenster dürfen sich weder überschneiden noch über Mitternacht reichen."
        }
      }
    },
    "set_doser_schedule": {
      "name": "Dosierplan setzen",
      "description": "Ersetzt die gesamte Dosiertabelle eines Reefdoser-Kanals. Die Pumpe folgt ihr nur, solange der Zeitplan-Schalter des Kanals eingeschaltet ist.",
      "fields": {
        "entity_id": {
          "name": "Dosierplan-Sensor",
          "description": "Dosierplan-Sensor(en) der zu programmierenden Kanäle."
        },
        "doses": {
          "name": "Dosierungen",
          "description": "Liste der Dosierungen (höchstens 24), jeweils mit time (HH:MM oder Minuten seit Mitternacht) und amount_ml (ganze ml). Eine leere Liste löscht das Programm. Zwei Dosierungen dürfen nicht in derselben Minute liegen."
        }
      }
    }
